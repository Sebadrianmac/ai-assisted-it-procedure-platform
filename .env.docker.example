# Django
DJANGO_SECRET_KEY=replace-with-a-secure-secret

# PostgreSQL
DB_NAME=ai_procedure_db
DB_USER=postgres
DB_PASSWORD=replace-with-a-secure-password
DB_HOST=db
DB_PORT=5432

# Port exposed from PostgreSQL to the host
POSTGRES_HOST_PORT=5433

# Frontend
VITE_API_URL=http://127.0.0.1:8000

# Local AI container
LOCAL_AI_BASE_URL=http://ai:8080
LOCAL_AI_MODEL=Qwen3-4B

# Absolute path to the GGUF model on the host machine
# Windows example:
AI_MODEL_PATH=C:/path/to/Qwen3-4B-Q4_K_M.gguf